# ==============================================================================
# 🚀 AL HADDAF MOBILE CAR WASH - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Do NOT commit your actual .env file to version control!
# Copy this file to .env and populate the values before deployment.

# ------------------------------------------------------------------------------
# 🗄️ DATABASE VARIABLES (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Used by Prisma Client for standard queries (Connection Pooler / Port 5432 or 6543)
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"

# DIRECT_URL: Used by Prisma for running migrations (Session connection / Port 5432)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Required once wrangler.toml's [[hyperdrive]] binding is active — lets
# `next build`/`next dev`/`wrangler dev` emulate it locally without a real
# local Postgres install. Same value as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://user:password@host:5432/postgres"

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION VARIABLES (NextAuth v5)
# ------------------------------------------------------------------------------
# AUTH_SECRET: Used to encrypt session data. Generate one via: `openssl rand -base64 33`
AUTH_SECRET="your_generated_random_secret_string_here"

# ------------------------------------------------------------------------------
# 👑 ADMIN VARIABLES (Initial Seeding)
# ------------------------------------------------------------------------------
# Used by prisma/seed.ts to create the default administrator account
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="choose_a_strong_password_here"

# ------------------------------------------------------------------------------
# 🌐 WEBSITE URL VARIABLES
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: The canonical URL of the application
# Used for SEO generation, sitemaps, and canonical links
NEXT_PUBLIC_SITE_URL="https://www.alhaddafcarwash.com"

# NEXTAUTH_URL: Cloudflare does not auto-inject this like Vercel did — set it
# explicitly to your live domain (also works as AUTH_URL, NextAuth v5's newer name).
NEXTAUTH_URL="https://www.alhaddafcarwash.com"
AUTH_URL="https://www.alhaddafcarwash.com"

# ------------------------------------------------------------------------------
# 🖼️ CLOUDINARY (Image Hosting for Service/Area/Blog/Review/Logo uploads)
# ------------------------------------------------------------------------------
# Used server-side only (signed uploads via lib/upload-image.ts) — get these
# 3 values from your Cloudinary dashboard (cloudinary.com/console) after
# creating a free account. R2 was the original plan (see wrangler.toml) but
# needs a one-time product activation in the Cloudflare dashboard; Cloudinary
# needs no such step, so it's the active image host for now.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 📊 ANALYTICS VARIABLES (Optional)
# ------------------------------------------------------------------------------
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Facebook Pixel ID (if running marketing campaigns)
NEXT_PUBLIC_FB_PIXEL_ID="XXXXXXXXXXXXXXX"
